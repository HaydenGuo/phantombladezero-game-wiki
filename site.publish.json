{
  "siteName": "phantombladezero-game-wiki",
  "domain": "phantombladezero-game.wiki",
  "canonicalHost": "phantombladezero-game.wiki",
  "publishPaths": [
    "site.publish.json",
    "site.template.json",
    ".env.example",
    ".gitignore",
    "src",
    "public",
    "scripts",
    "api",
    "migrations",
    "tests",
    "docs/template-baseline.json",
    "package.json",
    "pnpm-lock.yaml"
  ],
  "envSync": [],
  "github": {
    "enabled": true,
    "owner": "HaydenGuo",
    "repo": "phantombladezero-game-wiki",
    "defaultBranch": "main",
    "visibility": "public",
    "commitMessage": "Configure GA4 and Search Console integrations"
  },
  "vercel": {
    "enabled": true,
    "projectName": "phantombladezero-game-wiki",
    "projectId": "prj_4fsVE54loSu90BYeRHGQ3SDKfkFg",
    "teamId": "team_ZZ1CvBnc1VXzmY6mrrtH86YA",
    "production": true,
    "bindDomains": true,
    "domains": [
      {
        "name": "phantombladezero-game.wiki"
      }
    ]
  },
  "domainBinding": {
    "registrar": "spaceship",
    "dnsProvider": "spaceship",
    "spaceship": {
      "apiKeyEnv": "SPACESHIP_API_KEY",
      "apiSecretEnv": "SPACESHIP_API_SECRET"
    },
    "dnsRecords": [
      {
        "address": "76.76.21.21",
        "name": "@",
        "type": "A",
        "ttl": 3600
      }
    ]
  },
  "analytics": {
    "enablePropertySetup": true,
    "gaIdEnv": "PUBLIC_GA_ID",
    "googleOAuthProfileRef": "default",
    "accountId": "404077639",
    "propertyDisplayName": "phantombladezero-game-wiki",
    "propertyTimeZone": "Asia/Shanghai",
    "propertyCurrencyCode": "USD",
    "dataStreamDisplayName": "phantombladezero-game-wiki Web",
    "dataStreamDefaultUri": "https://phantombladezero-game.wiki"
  },
  "searchConsole": {
    "enabled": true,
    "enablePropertySetup": true,
    "googleOAuthProfileRef": "default",
    "enableSitemapSubmit": true,
    "enableIndexInspection": false,
    "propertyVerificationAttempts": 6,
    "propertyVerificationDelaySeconds": 10,
    "siteUrl": "sc-domain:phantombladezero-game.wiki",
    "sitemapUrl": "https://phantombladezero-game.wiki/sitemap-index.xml"
  }
}
